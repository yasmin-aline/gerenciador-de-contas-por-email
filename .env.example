# Copie para .env e preencha. NUNCA suba o .env nem os arquivos de secrets/.

# ID da planilha: o trecho da URL entre /d/ e /edit
SPREADSHEET_ID=
# Chave JSON da conta de serviço do Google (compartilhe a planilha com o e-mail dela como Editor)
GOOGLE_SERVICE_ACCOUNT_FILE=secrets/service-account.json

# Gmail criado só para o bot (com verificação em duas etapas) e a senha de app dele
BOT_EMAIL=
BOT_EMAIL_APP_PASSWORD=
# Seu e-mail: para onde vão os avisos e de onde o bot aceita respostas
DESTINATARIO_EMAIL=

# Chave do Gemini (crie uma nova em aistudio.google.com/apikey, só para este projeto).
# Sem ela o bot avisa e não entende texto livre.
GEMINI_API_KEY=
# Modelo: use um que sua chave consiga usar (o mesmo do seu outro projeto serve). Padrão: gemini-flash-latest
# GEMINI_MODEL=gemini-flash-latest
# Modelo reserva (opcional): só é usado se o principal responder "alta demanda" (503) mesmo após 3 tentativas.
# GEMINI_MODEL_FALLBACK=
# (Alternativa paga: ANTHROPIC_API_KEY / ANTHROPIC_MODEL. Se as duas existirem, vale o Gemini.)

# Opcionais (valores padrão abaixo)
# RECEBE_DIA15=2200
# RECEBE_FIM_MES=1800
# LIMITE_DESVIO=0.30
# CONFIANCA_MINIMA=0.75
# APELIDOS_FILE=apelidos.json
